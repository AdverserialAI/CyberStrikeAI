# syntax=docker/dockerfile:1.7

FROM golang:1.25-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/cyberstrike-ai ./cmd/server

FROM node:22-bookworm-slim AS pi-builder
WORKDIR /runtime/pi
COPY runtime/pi/package.json runtime/pi/package-lock.json ./
RUN npm ci
COPY runtime/pi/tsconfig.json ./
COPY runtime/pi/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
ARG ARTIFACT_VERSION=dev
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git iproute2 procps python3 python3-venv tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/cyberstrike
COPY requirements.txt ./
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt
COPY --from=builder /out/cyberstrike-ai /usr/local/bin/cyberstrike-ai
COPY agents knowledge_base mcp-servers plugins roles skills tools web ./
COPY --from=pi-builder /runtime/pi ./runtime/pi
COPY config.example.yaml LICENSE ./
RUN groupadd --gid 10001 cyberstrike \
    && useradd --uid 10001 --gid 10001 --create-home cyberstrike \
    && mkdir -p /var/lib/cyberstrike \
    && chown -R cyberstrike:cyberstrike /opt/cyberstrike /var/lib/cyberstrike
USER cyberstrike
VOLUME ["/var/lib/cyberstrike"]
EXPOSE 8080
ENV CYBERSTRIKE_CONFIG=/var/lib/cyberstrike/config.yaml PATH=/opt/venv/bin:$PATH
LABEL org.opencontainers.image.title="CyberStrikeAI" \
      org.opencontainers.image.version="${ARTIFACT_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/sh", "-c", "test -f \"$CYBERSTRIKE_CONFIG\" || cp /opt/cyberstrike/config.example.yaml \"$CYBERSTRIKE_CONFIG\"; exec cyberstrike-ai -config \"$CYBERSTRIKE_CONFIG\" --http \"$@\"", "cyberstrike-ai"]
